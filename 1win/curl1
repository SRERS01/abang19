        const tooltipRoots = document.querySelectorAll(".tooltip_root");

       
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                tooltipRoots.forEach((tooltipRoot) => {
                    tooltipRoot.classList.remove("tooltip_root--active");
                });
            }
        });
        document.addEventListener('click', (event) => {
            tooltipRoots.forEach((tooltipRoot) => {
                
                if (!tooltipRoot.contains(event.target)) {
                    tooltipRoot.classList.remove("tooltip_root--active");
                }
            });
        });

        tooltipRoots.forEach((tooltipRoot) => {
            const tooltipTrigger = tooltipRoot.querySelector(".tooltip_trigger");
            const closeButton = tooltipRoot.querySelector(".tooltip__close");

            
            if (tooltipTrigger) {
                tooltipTrigger.addEventListener("click", function (event) {
                    event.stopPropagation(); 
                    tooltipRoot.classList.toggle("tooltip_root--active");
                });
            }

            
            if (closeButton) {
                closeButton.addEventListener("click", function (event) {
                    event.stopPropagation();
                    tooltipRoot.classList.remove("tooltip_root--active");
                });
            }
        });
    };

